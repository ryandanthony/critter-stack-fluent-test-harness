<Project Sdk="Microsoft.NET.Sdk">
  <!-- A stand-in for a consuming service's test project. It is deliberately NOT built with this repo's
       Directory.Build.props: scripts/check-package.sh copies it into a throwaway directory and restores the harness
       as a NuGet package, as the add-to-a-service how-to describes. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="WolverineFx.Marten" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="CritterStack.TestHarness" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
