<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ships as the CritterStack.TestHarness NuGet package (ADR-0013). Analyzers and GitVersion come from
       Directory.Build.props with PrivateAssets="all", so the package depends on Alba, Marten and WolverineFx only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CritterStack.TestHarness</RootNamespace>
    <Description>Fluent Given/When/Then test harness for Marten and Wolverine.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CritterStack.TestHarness</PackageId>
    <Authors>Ryan Anthony</Authors>
    <PackageTags>marten;wolverine;alba;critterstack;testing;event-sourcing;given-when-then</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ryandanthony/critter-stack-fluent-test-harness</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ryandanthony/critter-stack-fluent-test-harness</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Alba" />
    <PackageReference Include="Marten" />
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CritterStack.TestHarness.Tests" />
  </ItemGroup>

</Project>
