<Project Sdk="Microsoft.NET.Sdk">

  <!-- Self-contained on purpose: a service copies this project into its own repo, so everything it needs to build
       is here, not in this repo's Directory.Build.props. Only the package *versions* come from the host repo. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CritterStack.TestHarness</RootNamespace>
    <Description>Fluent Given/When/Then test harness for Marten and Wolverine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Alba" />
    <PackageReference Include="Marten" />
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CritterStack.TestHarness.Tests" />
  </ItemGroup>

</Project>
